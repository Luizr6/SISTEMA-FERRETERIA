# Configuración del archivo .env corregida para PostgreSQL y Spring Boot

# --- Django ---
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=django-insecure-ferreteria-secret-key-2026-aleatoria
DJANGO_ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- JWT ---
JWT_ACCESS_MINUTOS=60
JWT_REFRESH_DIAS=7

# --- Base de datos (PostgreSQL) ---
POSTGRES_DB=ferreteria
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin123
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Datos del negocio (salen en el comprobante PDF) ---
FERRETERIA_NOMBRE=Ferretería El Constructor
FERRETERIA_RUC=20000000001
FERRETERIA_DIRECCION=Av. Principal 123
FERRETERIA_TELEFONO=999 999 999
FERRETERIA_SERIE=B001

# --- Recuperacion de contrasena ---
FRONTEND_URL=http://localhost:5173
# Sin EMAIL_HOST el correo se imprime en la consola de runserver
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=tucorreo@gmail.com
# EMAIL_HOST_PASSWORD=clave-de-aplicacion

# --- WhatsApp Cloud API (Sprint 7). Sin TOKEN funciona en modo SIMULADO ---
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=ferreteria-verify-2026
# WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# --- Microservicio Spring Boot de reportes y auditoría ---
MS_AUDITORIA_URL=http://localhost:8081/api/auditoria/eventos
MS_API_KEY=clave-servicio-dev-2026