# Configuración del archivo .env corregida para PostgreSQL y Spring Boot

# --- Django ---
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=django-insecure-ferreteria-secret-key-2026-aleatoria
DJANGO_ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- JWT ---
JWT_ACCESS_MINUTOS=60
JWT_REFRESH_DIAS=30

# --- Base de datos (PostgreSQL) ---
POSTGRES_DB=ferreteria
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin123
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Datos del negocio (salen en el comprobante PDF) ---
FERRETERIA_NOMBRE=FERRETERÍA C&R
FERRETERIA_RUC=20000000001
FERRETERIA_DIRECCION=av.virgilio purizaga, San Pedro, Peru, 423
FERRETERIA_TELEFONO=916 952 032
FERRETERIA_SERIE=B001
FERRETERIA_HORARIO=Lunes a sábado de 8:00 a. m. a 7:00 p. m.
# Horario que usa el bot cuando el cliente pide un asesor (0 = lunes ... 6 = domingo)
FERRETERIA_DIAS_ATENCION=0-5
FERRETERIA_HORA_APERTURA=08:00
FERRETERIA_HORA_CIERRE=19:00
# SUNAT: boletas mayores a este monto deben llevar el DNI del cliente
FERRETERIA_BOLETA_LIMITE_SIN_DNI=700

# --- Recuperacion de contrasena ---
FRONTEND_URL=http://localhost:5173
# Sin EMAIL_HOST el correo se imprime en la consola de runserver
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=tucorreo@gmail.com
# EMAIL_HOST_PASSWORD=clave-de-aplicacion

# --- WhatsApp Cloud API (Sprint 7). Sin TOKEN funciona en modo SIMULADO ---
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=ferreteria-verify-2026
# WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# --- Microservicio Spring Boot de reportes y auditoría ---
MS_AUDITORIA_URL=http://localhost:8081/api/auditoria/eventos
MS_API_KEY=clave-servicio-dev-2026
# Facturación y reportes en Spring (si se deja vacío se deduce de MS_AUDITORIA_URL).
# El comprobante de cada venta lo emite Spring; si no responde, Django entrega su PDF interno.
MS_REPORTES_URL=http://localhost:8081/api
# Serie de facturas (clientes con RUC); la de boletas es FERRETERIA_SERIE (B001)
FERRETERIA_SERIE_FACTURA=F001

# --- IA (Groq): bot de WhatsApp y asistente del Administrador ---
# Sin GROQ_API_KEY el bot responde por reglas y el asistente da un resumen básico.
# La clave se crea gratis en https://console.groq.com/keys  (NUNCA subirla a GitHub)
# GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Si el principal llega a su límite gratuito por minuto, se usa este (tiene su propio cupo)
GROQ_MODEL_RESPALDO=openai/gpt-oss-20b
IA_TIMEOUT_SEGUNDOS=20
IA_HISTORIAL_MENSAJES=4

# --- Caja ---
# True: nadie puede cobrar (web, app ni aprobar pedidos de WhatsApp) sin abrir su caja.
CAJA_OBLIGATORIA=True
