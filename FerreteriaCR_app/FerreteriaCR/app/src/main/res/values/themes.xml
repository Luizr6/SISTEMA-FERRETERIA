<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Tema claro y profesional: azul marino + ámbar (igual que el panel web) -->
    <style name="Theme.FerreteriaCR" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/navy</item>
        <item name="colorOnPrimary">@color/blanco</item>
        <item name="colorPrimaryContainer">@color/ambar_suave</item>
        <item name="colorOnPrimaryContainer">@color/navy</item>
        <item name="colorSecondary">@color/ambar</item>
        <item name="colorOnSecondary">@color/navy</item>
        <item name="colorSecondaryContainer">@color/ambar_suave</item>
        <item name="colorOnSecondaryContainer">@color/navy</item>
        <item name="colorSurface">@color/superficie</item>
        <item name="colorOnSurface">@color/texto</item>
        <item name="colorError">@color/rojo</item>
        <item name="android:colorBackground">@color/fondo</item>
        <item name="android:windowBackground">@color/fondo</item>
        <item name="android:statusBarColor">@color/navy</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/superficie</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.FerreteriaCR.Dialogo</item>
    </style>

    <!-- Pantalla del PIN: fondo azul marino completo -->
    <style name="Theme.FerreteriaCR.Navy" parent="Theme.FerreteriaCR">
        <item name="android:windowBackground">@color/navy</item>
        <item name="android:navigationBarColor">@color/navy</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>

    <style name="ThemeOverlay.FerreteriaCR.Dialogo" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/navy</item>
    </style>

    <!-- Botón principal: ámbar con texto azul marino -->
    <style name="Boton.Principal" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/ambar</item>
        <item name="android:textColor">@color/navy</item>
        <item name="iconTint">@color/navy</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Botón azul marino -->
    <style name="Boton.Navy" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/navy</item>
        <item name="android:textColor">@color/blanco</item>
        <item name="iconTint">@color/blanco</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Botón con borde -->
    <style name="Boton.Borde" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/navy</item>
        <item name="iconTint">@color/navy</item>
        <item name="strokeColor">@color/borde</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Boton.Peligro" parent="Boton.Borde">
        <item name="android:textColor">@color/rojo</item>
        <item name="iconTint">@color/rojo</item>
        <item name="strokeColor">@color/rojo</item>
    </style>

    <!-- Chips de filtro (categorías, estados) -->
    <style name="Chip.Filtro" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_fondo</item>
        <item name="android:textColor">@color/chip_texto</item>
        <item name="chipStrokeColor">@color/borde</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipCornerRadius">18dp</item>
        <item name="chipMinHeight">36dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Tarjeta blanca -->
    <style name="Tarjeta" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/superficie</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- Textos -->
    <style name="Texto.TituloBarra" parent="">
        <item name="android:textColor">@color/blanco</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Texto.Seccion" parent="">
        <item name="android:textColor">@color/navy</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Texto.Etiqueta" parent="">
        <item name="android:textColor">@color/texto_2</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Texto.Insignia" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:background">@drawable/bg_insignia</item>
    </style>

    <style name="CampoTexto" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/navy</item>
        <item name="hintTextColor">@color/navy</item>
    </style>

    <style name="BarraInferior" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/superficie</item>
        <item name="itemIconTint">@color/nav_item</item>
        <item name="itemTextColor">@color/nav_item</item>
        <item name="itemActiveIndicatorStyle">@style/BarraInferior.Indicador</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <style name="BarraInferior.Indicador" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/ambar_suave</item>
    </style>
</resources>
